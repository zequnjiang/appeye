# Node.js 24+。复制为 .env 后设置独立密码；不要将 .env 提交到 Git。
ADMIN_PASSWORD=
# 留空可自动生成进程内会话签名密钥，重启后所有会话失效。
SESSION_SECRET=
HOST=127.0.0.1
PORT=3000
# 正式 data/appeye.sqlite；演示请显式改为 data/demo.sqlite 并启用 DEMO_MODE。
DATABASE_PATH=data/appeye.sqlite
DEMO_MODE=false
# 启用国家每60分钟安排发现和详情；false暂停小时任务，手动及已冻结全量批次仍运行。
AUTO_SCHEDULE=true
# 所有采集通道共享限速；iTunes search/lookup额外至少3100ms。
SCRAPE_DELAY_MS=500
SCRAPE_TIMEOUT_MS=30000
# 可选：只恢复这个已经seed的全量批次；留空自动选择最近仍有待执行页的批次，不创建新批次。
FULL_SCAN_BATCH_ID=
# HTTPS 反向代理后设为 true；允许来源用逗号分隔的完整 origin，不能通配。
COOKIE_SECURE=false
# ALLOWED_ORIGINS=https://appeye.example.com
