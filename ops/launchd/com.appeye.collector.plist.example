<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.appeye.collector</string>
  <key>ProgramArguments</key><array><string>ABSOLUTE_NODE_PATH</string><string>ABSOLUTE_PROJECT_PATH/dist/server/index.js</string></array>
  <key>WorkingDirectory</key><string>ABSOLUTE_PROJECT_PATH</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>40</integer>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key><dict><key>NODE_ENV</key><string>production</string></dict>
  <key>StandardOutPath</key><string>ABSOLUTE_PROJECT_PATH/.artifacts/appeye-service.log</string>
  <key>StandardErrorPath</key><string>ABSOLUTE_PROJECT_PATH/.artifacts/appeye-service.error.log</string>
</dict></plist>
